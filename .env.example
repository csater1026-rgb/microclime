# Copy to .env.local for `vercel dev`, or set these in your Vercel project's
# environment variables for the deployed site.

# Powers the AI plant-photo analysis in the "Plant & grass burn risk"
# section. Without this set, that feature runs in a clearly-labeled demo
# mode instead of calling a live model.
AI_API_KEY=

# Defaults to Google Gemini via its OpenAI-compatible API. Override only if
# using a different OpenAI-compatible provider.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.6-flash
